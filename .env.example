# Names only. Copy this file to .env and fill in the values. Never commit .env.
# The same names are used as GitHub Actions secrets (see push_github_secrets.py).

GEMINI_API_KEY=
MS_CLIENT_ID=
# Written by outlook_signin.py (run it once). Do not fill in by hand.
MS_TOKEN_CACHE=
SLACK_WEBHOOK_URL=
# The #automation-log channel link.
SLACK_LOG_WEBHOOK_URL=
# Only for --slack test. Not copied to GitHub.
SLACK_TEST_WEBHOOK_URL=
ATTIO_API_KEY=
# The deal owner's email address, as in Attio.
ATTIO_DEAL_OWNER=
